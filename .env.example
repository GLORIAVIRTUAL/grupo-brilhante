# Frontend / Base44
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_INTEGRATION_DEMO_MODE=false

# Base44 runtime
BASE44_APP_ID=

# IA e processamento de imagens
GEMINI_API_KEY=
# Lista separada por vírgulas dos hosts HTTPS autorizados para fotos armazenadas.
AI_IMAGE_ALLOWED_HOSTS=

# Pagamentos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exemplo: https://app.exemplo.com,https://gestao.exemplo.com
PAYMENT_ALLOWED_ORIGINS=

# Automação interna e chamadas server-side encadeadas
# Gere um valor aleatório forte no gerenciador de segredos da plataforma.
INTERNAL_FUNCTION_TOKEN=
ENABLE_INTERNAL_DEBUG_ENDPOINTS=false

# WhatsApp / Z-API principal
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_SECURITY_TOKEN=
# Lista separada por vírgulas dos hosts HTTPS de mídia autorizados para download.
MEDIA_DOWNLOAD_HOST_ALLOWLIST=

# WhatsApp / Z-API Moinhos
ZAPI_MOINHOS_INSTANCE_ID=
ZAPI_MOINHOS_TOKEN=
ZAPI_MOINHOS_SECURITY_TOKEN=

# WhatsApp Cloud API Moinhos
WHATSAPP_MOINHOS_ACCESS_TOKEN=
WHATSAPP_MOINHOS_PHONE_NUMBER_ID=
WHATSAPP_MOINHOS_VERIFY_TOKEN=
WHATSAPP_MOINHOS_APP_SECRET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Meta Ads
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# Webhooks opcionais de automação
MAKE_INSTAGRAM_WEBHOOK_URL=
MAKE_VIDEO_WEBHOOK_URL=

# Migração Conta Azul — execução definitiva desativada por padrão
CONTA_AZUL_MIGRATION_ENABLED=false

# Banco do Brasil — Cobrança, Pix e conciliação
# Valores possíveis: disabled, sandbox, homologation, production
BB_ENVIRONMENT=disabled
BB_EXTERNAL_REQUESTS_ENABLED=false
BB_PRODUCTION_ENABLED=false
BB_API_BASE_URL=
BB_OAUTH_URL=
BB_DEVELOPER_APPLICATION_KEY=
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_BILLING_AGREEMENT_NUMBER=
BB_WALLET_NUMBER=
BB_WALLET_VARIATION=
BB_PIX_KEY=
# Paths fornecidos pelo Portal Developers para o convênio homologado.
BB_CHARGE_CREATE_PATH=
BB_CHARGE_CANCEL_PATH=
BB_PIX_CREATE_PATH=
BB_PIX_CANCEL_PATH=
BB_PIX_REFUND_PATH=
# Credenciais exclusivas do endpoint de webhook; nunca usar em URL/query string.
BB_WEBHOOK_TOKEN=
BB_WEBHOOK_HMAC_SECRET=

# Focus NFe — emissão fiscal permanece desativada até homologação explícita
FOCUSNFE_EXTERNAL_REQUESTS_ENABLED=false
FOCUSNFE_PRODUCTION_ENABLED=false
FOCUSNFE_HOMOLOGATION_TOKEN=
FOCUSNFE_PRODUCTION_TOKEN=
# Compatibilidade temporária; prefira tokens separados por ambiente
FOCUSNFE_TOKEN=
FOCUSNFE_WEBHOOK_TOKEN=
FOCUSNFE_WEBHOOK_HEADER=x-focusnfe-webhook-token
FOCUSNFE_WEBHOOK_ENVIRONMENT=homologation

# Sistema de DP — somente dados operacionais de equipe e escala
# Folha, férias, admissões, rescisões e cálculos trabalhistas permanecem no provedor atual.
PAYROLL_SYNC_ENABLED=false
PAYROLL_SYNC_PRODUCTION_ENABLED=false
PAYROLL_API_BASE_URL=
PAYROLL_API_TOKEN=
PAYROLL_ALLOWED_HOSTS=
PAYROLL_SCHEDULE_PATH=

# Relatórios agendados — entrega interna funciona sem integrações externas
REPORT_EXTERNAL_DELIVERY_ENABLED=false
