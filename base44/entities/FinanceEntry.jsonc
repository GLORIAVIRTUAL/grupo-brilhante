{
  "name": "FinanceEntry",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["income", "expense"],
      "description": "Entrada ou saída financeira"
    },
    "category": {
      "type": "string",
      "description": "Categoria do lançamento"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Valor em BRL"
    },
    "payment_method": {
      "type": "string",
      "enum": ["credit", "debit", "pix", "cash", "link", "boleto", "transfer", "bank_transfer", "check", "mixed", "other"],
      "default": "cash"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "unit_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "pending", "paid", "cancelled", "reconciled"],
      "default": "paid"
    },
    "accounts_payable_id": { "type": "string" },
    "accounts_receivable_id": { "type": "string" },
    "financial_document_id": { "type": "string" },
    "purchase_document_id": { "type": "string" },
    "cash_session_id": { "type": "string" },
    "bank_transaction_id": { "type": "string" },
    "cancelled_at": { "type": "string", "format": "date-time" },
    "cancelled_by_user_id": { "type": "string" },
    "cancel_reason": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["type", "amount"]
}
