{
  "name": "RouteStop",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "route_id": { "type": "string" },
    "stop_type": { "type": "string", "enum": ["pickup", "delivery", "mixed", "return_to_unit"] },
    "pickup_id": { "type": "string" },
    "delivery_receipt_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "order_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "sequence": { "type": "number" },
    "status": { "type": "string", "enum": ["planned", "en_route", "arrived", "servicing", "completed", "failed", "skipped", "cancelled"], "default": "planned" },
    "address": { "type": "string" },
    "neighborhood": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "planned_arrival_at": { "type": "string", "format": "date-time" },
    "arrival_at": { "type": "string", "format": "date-time" },
    "service_started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "attempt_count": { "type": "number", "default": 0 },
    "failure_reason_code": { "type": "string" },
    "failure_notes": { "type": "string" },
    "confirmation_code_hash": { "type": "string" },
    "recipient_name": { "type": "string" },
    "recipient_document_last4": { "type": "string" },
    "proof_asset_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "signature_asset_id": { "type": "string" },
    "check_in_location": { "type": "object", "additionalProperties": true },
    "check_out_location": { "type": "object", "additionalProperties": true },
    "distance_from_target_meters": { "type": "number" },
    "duration_minutes": { "type": "number", "default": 0 },
    "notes": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "request_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["unit_id", "route_id", "stop_type", "sequence", "status", "address"]
}
