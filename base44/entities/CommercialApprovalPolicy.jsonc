{
  "name": "CommercialApprovalPolicy",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "unit_id": { "type": "string" },
    "role": { "type": "string" },
    "max_discount_percent": { "type": "number", "default": 0 },
    "max_discount_amount": { "type": "number", "default": 0 },
    "max_addition_percent": { "type": "number", "default": 100 },
    "max_courtesy_amount": { "type": "number", "default": 0 },
    "requires_reason_above_percent": { "type": "number", "default": 0 },
    "requires_different_approver_above_percent": { "type": "number", "default": 10 },
    "require_mfa_above_percent": { "type": "number", "default": 20 },
    "active": { "type": "boolean", "default": true },
    "version": { "type": "number", "default": 1 },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "created_by_user_id": { "type": "string" },
    "approved_by_user_id": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "change_reason": { "type": "string" }
  },
  "required": ["name", "role", "version"]
}
