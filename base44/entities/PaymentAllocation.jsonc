{
  "name": "PaymentAllocation",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "payment_id": { "type": "string" },
    "payment_receipt_id": { "type": "string" },
    "accounts_receivable_id": { "type": "string" },
    "accounts_payable_id": { "type": "string" },
    "order_id": { "type": "string" },
    "garment_item_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "amount": { "type": "number" },
    "allocation_type": { "type": "string", "enum": ["receipt", "payment", "refund", "credit_balance"] },
    "status": { "type": "string", "enum": ["pending", "posted", "reversed", "cancelled"], "default": "posted" },
    "sequence": { "type": "number" },
    "allocated_at": { "type": "string", "format": "date-time" },
    "reversed_at": { "type": "string", "format": "date-time" },
    "reversed_by_user_id": { "type": "string" },
    "reversal_allocation_id": { "type": "string" },
    "reversal_reason": { "type": "string" },
    "allocated_by_user_id": { "type": "string" },
    "request_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["unit_id", "amount", "allocation_type", "allocated_at"]
}
