{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo curto da promo\u00e7\u00e3o (ex: '10% OFF em 2 edredons')"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o completa da promo\u00e7\u00e3o, regras e condi\u00e7\u00f5es. O chatbot l\u00ea este texto."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a promo\u00e7\u00e3o est\u00e1 ativa e deve ser considerada pelo chatbot"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de validade da promo\u00e7\u00e3o (opcional)"
    }
  },
  "required": [
    "title",
    "description"
  ]
}