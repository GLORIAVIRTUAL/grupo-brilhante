{
  "name": "CardFee",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "description": "Bandeira do cart\u00e3o (ex: Visa, Mastercard, Elo)"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "debit",
        "credit"
      ],
      "description": "Tipo do cart\u00e3o (d\u00e9bito ou cr\u00e9dito)"
    },
    "debit_fee": {
      "type": "number",
      "default": 0,
      "description": "Taxa (%) para d\u00e9bito"
    },
    "credit_fees": {
      "type": "object",
      "description": "Mapa de taxas por n\u00famero de parcelas no cr\u00e9dito. Chave = parcelas (1,2,3...), valor = taxa em %"
    },
    "unit_id": {
      "type": "string",
      "description": "ID da unidade respons\u00e1vel (opcional)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "brand",
    "card_type"
  ]
}