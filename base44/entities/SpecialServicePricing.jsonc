{
  "name": "SpecialServicePricing",
  "type": "object",
  "properties": {
    "item_label": {
      "type": "string",
      "description": "Nome da pe\u00e7a exibido na tabela (ex: Edredom, Casacos, Demais Pe\u00e7as)"
    },
    "keywords": {
      "type": "string",
      "description": "Palavras-chave separadas por v\u00edrgula que a IA usa para identificar a pe\u00e7a na conversa. Deixe vazio para a linha 'Demais Pe\u00e7as'."
    },
    "bactericida": {
      "type": "number",
      "description": "Valor do servi\u00e7o Bactericida (R$)"
    },
    "revitalizante": {
      "type": "number",
      "description": "Valor de Branco+ / Revitalizante / Engomagem (R$). Vazio = n\u00e3o dispon\u00edvel."
    },
    "impermeabilizacao": {
      "type": "number",
      "description": "Valor da Impermeabiliza\u00e7\u00e3o (R$). Vazio = n\u00e3o dispon\u00edvel."
    },
    "per_m2": {
      "type": "boolean",
      "default": false,
      "description": "Se o valor \u00e9 cobrado por m\u00b2"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o na tabela"
    }
  },
  "required": [
    "item_label"
  ]
}