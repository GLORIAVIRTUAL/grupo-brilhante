{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome comercial da peça ou serviço"
    },
    "sku": {
      "type": "string",
      "description": "Código estável para integrações, etiquetas e importações"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Sinônimos e nomes regionais usados na busca e no reconhecimento"
    },
    "description": {
      "type": "string",
      "description": "Descrição comercial ou orientação operacional"
    },
    "family": {
      "type": "string",
      "description": "Família do item, como Cama, Mesa, Banho, Roupas, Tratamentos, Planos ou Bags"
    },
    "category": {
      "type": "string",
      "enum": [
        "Limpeza",
        "Passadoria",
        "Costura",
        "Outros",
        "Especial",
        "Planos",
        "Bags"
      ],
      "default": "Limpeza"
    },
    "price": {
      "type": "number",
      "description": "Preço unitário padrão em BRL"
    },
    "unit_of_measure": {
      "type": "string",
      "enum": [
        "piece",
        "pair",
        "kg",
        "square_meter",
        "bag",
        "service"
      ],
      "default": "piece"
    },
    "default_service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "applicable_attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "color",
          "brand",
          "pattern",
          "size",
          "material",
          "condition",
          "dimensions"
        ]
      },
      "default": [
        "color",
        "brand",
        "pattern",
        "size",
        "condition"
      ]
    },
    "material_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visual_example_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Referências visuais autorizadas para avaliação e matching"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "image_url": {
      "type": "string",
      "description": "Ícone ou imagem principal"
    },
    "catalog_version": {
      "type": "string",
      "default": "1"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_until": {
      "type": "string",
      "format": "date-time"
    },
    "service_code": {
      "type": "string",
      "description": "Código interno/fiscal opcional do serviço"
    }
  },
  "required": [
    "name",
    "price"
  ]
}
