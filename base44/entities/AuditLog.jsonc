{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "view",
        "update",
        "delete",
        "approve",
        "reject",
        "export",
        "login",
        "logout",
        "upload",
        "download",
        "reconcile",
        "refund",
        "status_change",
        "permission_change",
        "ai_review"
      ],
      "default": "delete",
      "description": "Ação de negócio ou segurança registrada"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "payment",
        "finance_entry",
        "order",
        "quote",
        "garment_item",
        "purchase_document",
        "stock_item",
        "stock_movement",
        "supplier",
        "accounts_payable",
        "accounts_receivable",
        "cash_session",
        "cash_movement",
        "financial_document",
        "third_party_job",
        "rework",
        "quality_check",
        "document_asset",
        "ai_job",
        "human_review",
        "user",
        "unit",
        "integration",
        "access_policy",
        "price_rule",
        "operational_catalog",
        "loyalty_program",
        "loyalty_ledger",
        "voucher",
        "customer_package",
        "vehicle",
        "field_route",
        "field_route_stop",
        "driver_shift",
        "specialized_report",
        "business_group",
        "legal_entity",
        "cost_center",
        "bank_account",
        "warehouse",
        "company_access_grant",
        "public_conversation_session",
        "integration_job",
        "repair_task",
        "domain_event",
        "business_party",
        "party_role",
        "party_contact",
        "party_address",
        "party_document",
        "sales_opportunity",
        "business_activity",
        "business_contract",
        "contract_version",
        "contract_price_item",
        "service_order",
        "financial_period",
        "intercompany_entry",
        "financial_projection",
        "reconciliation_batch",
        "migration_batch",
        "migration_record",
        "bank_charge",
        "bank_webhook_event",
        "bank_reconciliation_match",
        "purchase_requisition",
        "purchase_requisition_item",
        "purchase_order",
        "purchase_order_item",
        "goods_receipt",
        "goods_receipt_item",
        "stock_transfer",
        "stock_transfer_item",
        "hospital_pickup",
        "weighing_record",
        "hospital_processing_lot",
        "hospital_delivery_conference",
        "hospital_billing_measurement",
        "linen_catalog_item",
        "linen_asset",
        "linen_movement",
        "linen_inventory_session",
        "linen_inventory_line",
        "linen_liability_term",
        "linen_loss_charge",
        "cleaning_site",
        "work_post",
        "work_schedule",
        "cleaning_checklist_template",
        "cleaning_inspection",
        "cleaning_occurrence",
        "service_measurement",
        "payroll_sync_job",
        "communication_consent",
        "message_template",
        "knowledge_article",
        "report_definition",
        "report_schedule",
        "executive_summary_snapshot"
      ],
      "description": "Tipo do registro afetado"
    },
    "entity_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "item_label": {
      "type": "string",
      "description": "Identificação legível do registro"
    },
    "customer_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "description": "Justificativa humana ou técnica da ação"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "legal_entity_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "description": "Identificador de correlação da requisição"
    },
    "session_id": {
      "type": "string"
    },
    "ip_hash": {
      "type": "string",
      "description": "Hash opcional do IP, evitando registrar o endereço bruto"
    },
    "before_data": {
      "type": "object",
      "additionalProperties": true
    },
    "after_data": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "success": {
      "type": "boolean",
      "default": true
    },
    "domain": {
      "type": "string",
      "enum": ["security", "commercial", "contracts", "operations", "finance", "fiscal", "inventory", "production", "quality", "crm", "loyalty", "analytics", "logistics", "integration", "system"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "notice", "warning", "critical"],
      "default": "info"
    },
    "result": {
      "type": "string",
      "enum": ["success", "denied", "validation_error", "failure"],
      "default": "success"
    },
    "origin": {
      "type": "string",
      "enum": ["web", "mobile", "api", "webhook", "automation", "system"],
      "default": "web"
    },
    "retention_class": {
      "type": "string",
      "enum": ["standard", "financial", "fiscal", "security", "privacy"],
      "default": "standard"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "masked_fields": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "required": [
    "entity_type",
    "reason"
  ]
}
