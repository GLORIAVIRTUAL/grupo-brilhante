{
  "name": "DeliveryRoute",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "code": { "type": "string" },
    "route_date": { "type": "string", "format": "date" },
    "route_type": { "type": "string", "enum": ["pickup", "delivery", "mixed"], "default": "mixed" },
    "status": { "type": "string", "enum": ["draft", "planned", "assigned", "in_progress", "paused", "completed", "cancelled"], "default": "draft" },
    "driver_user_id": { "type": "string" },
    "driver_name": { "type": "string" },
    "vehicle_id": { "type": "string" },
    "stop_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "planned_stop_count": { "type": "number", "default": 0 },
    "completed_stop_count": { "type": "number", "default": 0 },
    "failed_stop_count": { "type": "number", "default": 0 },
    "planned_distance_km": { "type": "number", "default": 0 },
    "actual_distance_km": { "type": "number", "default": 0 },
    "planned_duration_minutes": { "type": "number", "default": 0 },
    "actual_duration_minutes": { "type": "number", "default": 0 },
    "planned_load_kg": { "type": "number", "default": 0 },
    "actual_load_kg": { "type": "number", "default": 0 },
    "estimated_cost": { "type": "number", "default": 0 },
    "actual_cost": { "type": "number", "default": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "paused_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "start_odometer_km": { "type": "number" },
    "end_odometer_km": { "type": "number" },
    "start_location": { "type": "object", "additionalProperties": true },
    "end_location": { "type": "object", "additionalProperties": true },
    "created_by_user_id": { "type": "string" },
    "closed_by_user_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "request_id": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["unit_id", "code", "route_date", "route_type", "status"]
}
