{
  "name": "BillingAgreement",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "suspended", "expired", "cancelled"], "default": "draft" },
    "agreement_type": { "type": "string", "enum": ["corporate", "condominium", "hotel", "healthcare", "employee", "partner", "other"] },
    "legal_name": { "type": "string" },
    "tax_id": { "type": "string" },
    "billing_email": { "type": "string" },
    "billing_contact": { "type": "string" },
    "bill_to_customer_id": { "type": "string", "description": "Cliente responsável pelo faturamento do convênio" },
    "customer_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "price_rule_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "credit_limit": { "type": "number", "default": 0 },
    "payment_term_days": { "type": "number", "default": 0 },
    "billing_cycle": { "type": "string", "enum": ["per_order", "weekly", "biweekly", "monthly"], "default": "monthly" },
    "closing_day": { "type": "number" },
    "due_day": { "type": "number" },
    "requires_cost_center": { "type": "boolean", "default": false },
    "requires_purchase_order": { "type": "boolean", "default": false },
    "requires_service_recipient": { "type": "boolean", "default": false },
    "allow_over_limit": { "type": "boolean", "default": false },
    "over_limit_requires_approval": { "type": "boolean", "default": true },
    "valid_from": { "type": "string", "format": "date" },
    "valid_until": { "type": "string", "format": "date" },
    "created_by_user_id": { "type": "string" },
    "approved_by_user_id": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["unit_id", "code", "name", "status", "agreement_type", "billing_cycle"]
}
