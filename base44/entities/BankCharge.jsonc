{
  "name": "BankCharge",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "bank_account_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "contract_id": { "type": "string" },
    "billing_statement_id": { "type": "string" },
    "accounts_receivable_id": { "type": "string" },
    "payment_id": { "type": "string" },
    "charge_type": { "type": "string", "enum": ["boleto", "pix_immediate", "pix_due_date" ] },
    "provider": { "type": "string", "enum": ["banco_do_brasil"], "default": "banco_do_brasil" },
    "provider_environment": { "type": "string", "enum": ["disabled", "sandbox", "homologation", "production"], "default": "disabled" },
    "internal_reference": { "type": "string" },
    "provider_charge_id": { "type": "string" },
    "txid": { "type": "string" },
    "our_number": { "type": "string" },
    "payer_name": { "type": "string" },
    "payer_tax_id": { "type": "string" },
    "payer_email": { "type": "string" },
    "payer_address": { "type": "object", "additionalProperties": true },
    "amount": { "type": "number" },
    "currency": { "type": "string", "default": "BRL" },
    "issue_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "queued", "transmitting", "active", "partially_paid", "paid", "expired", "cancel_pending", "cancelled", "refund_pending", "refunded", "failed", "repair_required"], "default": "draft" },
    "digitable_line": { "type": "string" },
    "barcode": { "type": "string" },
    "qr_code_text": { "type": "string" },
    "qr_code_location": { "type": "string" },
    "settled_amount": { "type": "number", "default": 0 },
    "settled_at": { "type": "string", "format": "date-time" },
    "bank_transaction_id": { "type": "string" },
    "integration_job_id": { "type": "string" },
    "last_provider_status": { "type": "string" },
    "last_provider_request_at": { "type": "string", "format": "date-time" },
    "last_provider_response_at": { "type": "string", "format": "date-time" },
    "safe_error_code": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "created_by_user_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "unit_id", "bank_account_id", "business_party_id", "charge_type", "provider", "provider_environment", "internal_reference", "amount", "currency", "issue_date", "status", "idempotency_key"]
}
