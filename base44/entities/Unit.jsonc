{
  "name": "Unit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da unidade operacional"
    },
    "legal_entity_id": {
      "type": "string",
      "description": "Empresa legal responsável pela unidade"
    },
    "code": {
      "type": "string",
      "description": "Código único da unidade dentro da empresa legal"
    },
    "unit_type": {
      "type": "string",
      "enum": ["headquarters", "branch", "industrial_plant", "service_hub", "warehouse", "customer_site", "other"],
      "default": "branch"
    },
    "cost_center_id": { "type": "string" },
    "default_warehouse_id": { "type": "string" },
    "subdomain": {
      "type": "string",
      "description": "Subdom\u00ednio associado \u00e0 unidade, ex: riobranco"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio da unidade"
    },
    "address": {
      "type": "string",
      "description": "Endereço legado em texto livre"
    },
    "structured_address": {
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "number": { "type": "string" },
        "complement": { "type": "string" },
        "district": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zip_code": { "type": "string" },
        "country": { "type": "string", "default": "BR" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "pending"
    },
    "plan_price": {
      "type": "number",
      "default": 489
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "late",
        "trial",
        "cancelled"
      ],
      "default": "trial",
      "description": "Status do pagamento da mensalidade"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_user_id": { "type": "string" },
    "updated_by_user_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": [
    "name",
    "subdomain",
    "owner_email"
  ]
}