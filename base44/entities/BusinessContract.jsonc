{
  "name": "BusinessContract",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "opportunity_id": { "type": "string" },
    "contract_number": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "title": { "type": "string" },
    "contract_type": { "type": "string", "enum": ["laundry_piece", "laundry_weight", "hospital_laundry", "linen_rental", "corporate_cleaning", "outsourcing", "mixed", "other"] },
    "billing_cycle": { "type": "string", "enum": ["per_service", "weekly", "biweekly", "monthly", "bimonthly", "quarterly", "annual"], "default": "monthly" },
    "billing_day": { "type": "number", "minimum": 1, "maximum": 28 },
    "payment_terms_days": { "type": "number", "minimum": 0, "maximum": 180, "default": 30 },
    "starts_on": { "type": "string", "format": "date" },
    "ends_on": { "type": "string", "format": "date" },
    "auto_renew": { "type": "boolean", "default": false },
    "renewal_notice_days": { "type": "number", "default": 60 },
    "adjustment_index": { "type": "string", "enum": ["ipca", "igpm", "inpc", "fixed", "none", "other"], "default": "ipca" },
    "adjustment_month": { "type": "number", "minimum": 1, "maximum": 12 },
    "last_adjustment_on": { "type": "string", "format": "date" },
    "next_adjustment_on": { "type": "string", "format": "date" },
    "minimum_monthly_amount": { "type": "number", "default": 0 },
    "credit_limit": { "type": "number", "default": 0 },
    "cost_center_id": { "type": "string" },
    "warehouse_id": { "type": "string" },
    "billing_contact_id": { "type": "string" },
    "service_address_id": { "type": "string" },
    "commercial_owner_user_id": { "type": "string" },
    "operational_owner_user_id": { "type": "string" },
    "sla": { "type": "object", "additionalProperties": true },
    "terms": { "type": "object", "additionalProperties": true },
    "current_version_id": { "type": "string" },
    "current_version_number": { "type": "number", "default": 0 },
    "signed_document_asset_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "pending_approval", "active", "suspended", "expired", "terminated"], "default": "draft" },
    "approved_at": { "type": "string", "format": "date-time" },
    "approved_by_user_id": { "type": "string" },
    "terminated_at": { "type": "string", "format": "date-time" },
    "termination_reason": { "type": "string" },
    "created_by_user_id": { "type": "string" },
    "updated_by_user_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "business_party_id", "contract_number", "title", "contract_type", "starts_on", "status"]
}
