{
  "name": "RecurringExpense",
  "type": "object",
  "properties": {
    "legal_entity_id": {
      "type": "string"
    },
    "cost_center_id": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string"
    },
    "competence_date": {
      "type": "string",
      "format": "date"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "native",
        "conta_azul",
        "bank",
        "provider",
        "migration",
        "other"
      ],
      "default": "native"
    },
    "external_id": {
      "type": "string"
    },
    "migration_record_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Descrição da despesa"
    },
    "category": {
      "type": "string",
      "description": "Categoria da despesa"
    },
    "amount": {
      "type": "number",
      "description": "Valor da despesa em BRL"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "pix",
        "credit",
        "debit",
        "boleto",
        "transfer",
        "link",
        "other"
      ],
      "default": "boleto",
      "description": "Forma de pagamento"
    },
    "kind": {
      "type": "string",
      "enum": [
        "recurring",
        "one_time"
      ],
      "default": "recurring",
      "description": "Recorrente (mensal) ou avulsa"
    },
    "day_of_month": {
      "type": "number",
      "default": 5,
      "description": "Dia do mês em que a despesa recorrente é lançada (1-31)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data programada para despesa avulsa"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a despesa recorrente está ativa"
    },
    "unit_id": {
      "type": "string",
      "description": "ID da unidade responsável"
    },
    "last_generated_month": {
      "type": "string",
      "description": "Mês (YYYY-MM) em que esta recorrente já foi lançada pela última vez, evita duplicação"
    },
    "notes": {
      "type": "string",
      "description": "Observações"
    }
  },
  "required": [
    "description",
    "category",
    "amount"
  ]
}
