{
  "name": "DocumentAsset",
  "type": "object",
  "properties": {
    "legal_entity_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "related_entity_type": { "type": "string" },
    "related_entity_id": { "type": "string" },
    "document_number": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"], "default": "internal" },
    "status": { "type": "string", "enum": ["active", "quarantined", "retired", "expired"], "default": "active" },
    "retired_at": { "type": "string", "format": "date-time" },
    "retired_by_user_id": { "type": "string" },
    "retirement_reason": { "type": "string" },
    "document_type": {
      "type": "string",
      "enum": [
        "garment_photo",
        "garment_label",
        "garment_damage",
        "purchase_invoice",
        "utility_bill",
        "service_invoice",
        "payment_receipt",
        "delivery_proof",
        "third_party_document",
        "corporate_document",
        "contract",
        "contract_addendum",
        "tax_document",
        "bank_document",
        "employee_document",
        "hospital_document",
        "linen_liability_term",
        "cleaning_evidence",
        "migration_source",
        "other"
      ]
    },
    "storage_key": {
      "type": "string",
      "description": "Identificador privado do objeto; não deve ser uma URL pública permanente"
    },
    "original_filename": {
      "type": "string"
    },
    "safe_filename": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "sha256": {
      "type": "string"
    },
    "scan_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "rejected",
        "quarantined",
        "not_configured"
      ],
      "default": "pending"
    },
    "scan_details": {
      "type": "string"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "valid",
        "invalid"
      ],
      "default": "pending"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "customer_shared",
        "internal_shared"
      ],
      "default": "private"
    },
    "retention_until": {
      "type": "string",
      "format": "date-time"
    },
    "retention_class": { "type": "string", "enum": ["standard", "financial", "fiscal", "security", "privacy", "employment", "contractual"], "default": "standard" },
    "created_by_user_id": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "unit_id",
    "document_type",
    "storage_key",
    "mime_type",
    "size_bytes",
    "sha256"
  ]
}
