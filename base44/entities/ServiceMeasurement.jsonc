{
  "name": "ServiceMeasurement",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "business_contract_id": { "type": "string" },
    "cleaning_site_id": { "type": "string" },
    "measurement_number": { "type": "string" },
    "period_start": { "type": "string", "format": "date-time" },
    "period_end": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "calculated", "customer_review", "approved", "invoiced", "disputed", "cancelled"], "default": "draft" },
    "planned_post_shifts": { "type": "number", "default": 0 },
    "covered_post_shifts": { "type": "number", "default": 0 },
    "uncovered_post_shifts": { "type": "number", "default": 0 },
    "worked_hours": { "type": "number", "default": 0 },
    "visit_count": { "type": "number", "default": 0 },
    "inspection_count": { "type": "number", "default": 0 },
    "average_quality_score": { "type": "number", "default": 0 },
    "base_amount": { "type": "number", "default": 0 },
    "materials_amount": { "type": "number", "default": 0 },
    "sla_discount_amount": { "type": "number", "default": 0 },
    "adjustment_amount": { "type": "number", "default": 0 },
    "total_amount": { "type": "number", "default": 0 },
    "calculation_snapshot": { "type": "object", "additionalProperties": true },
    "work_schedule_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "inspection_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "occurrence_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "approved_by_user_id": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "customer_approved_by_name": { "type": "string" },
    "customer_approved_at": { "type": "string", "format": "date-time" },
    "customer_signature_asset_id": { "type": "string" },
    "accounts_receivable_id": { "type": "string" },
    "bank_charge_id": { "type": "string" },
    "fiscal_document_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "business_party_id", "business_contract_id", "measurement_number", "period_start", "period_end", "status", "idempotency_key"]
}
