{
  "name": "Prospect",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nome da empresa prospectada"
    },
    "phone": {
      "type": "string",
      "description": "Telefone principal da empresa"
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de telefones da empresa"
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do s\u00f3cio"
          },
          "role": {
            "type": "string",
            "description": "Cargo do s\u00f3cio"
          }
        }
      },
      "description": "S\u00f3cios da empresa com seus cargos"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do contato respons\u00e1vel"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "segment": {
      "type": "string",
      "description": "Segmento/ramo da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "contatado",
        "negociando",
        "convertido",
        "descartado"
      ],
      "default": "novo",
      "description": "Status da prospec\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a prospec\u00e7\u00e3o"
    },
    "unit_id": {
      "type": "string",
      "description": "ID da unidade respons\u00e1vel pela prospec\u00e7\u00e3o"
    },
    "legal_entity_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "sales_opportunity_id": { "type": "string" },
    "source": { "type": "string" },
    "source_detail": { "type": "string" },
    "landing_page": { "type": "string" },
    "utm": { "type": "object", "additionalProperties": true },
    "communication_consent_id": { "type": "string" },
    "qualification_score": { "type": "number", "default": 0 },
    "converted_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": [
    "company_name",
    "phone"
  ]
}