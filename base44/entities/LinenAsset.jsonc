{
  "name": "LinenAsset",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "warehouse_id": { "type": "string" },
    "linen_catalog_item_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "customer_unit_id": { "type": "string" },
    "business_contract_id": { "type": "string" },
    "asset_code": { "type": "string" },
    "batch_number": { "type": "string" },
    "barcode": { "type": "string" },
    "qr_code": { "type": "string" },
    "rfid_code": { "type": "string" },
    "quantity": { "type": "number", "default": 1 },
    "status": { "type": "string", "enum": ["available", "delivered", "in_use", "awaiting_pickup", "soiled", "in_processing", "clean", "damaged", "lost", "quarantine", "retired"], "default": "available" },
    "wash_count": { "type": "number", "default": 0 },
    "expected_lifetime_washes": { "type": "number", "default": 0 },
    "acquisition_date": { "type": "string", "format": "date-time" },
    "acquisition_cost": { "type": "number", "default": 0 },
    "replacement_cost": { "type": "number", "default": 0 },
    "current_location_type": { "type": "string", "enum": ["warehouse", "customer", "vehicle", "production", "route", "unknown"], "default": "warehouse" },
    "current_location_id": { "type": "string" },
    "last_movement_at": { "type": "string", "format": "date-time" },
    "retired_at": { "type": "string", "format": "date-time" },
    "retirement_reason": { "type": "string" },
    "active": { "type": "boolean", "default": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "linen_catalog_item_id", "asset_code", "quantity", "status"]
}
