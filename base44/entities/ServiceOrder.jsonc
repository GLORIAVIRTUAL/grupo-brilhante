{
  "name": "ServiceOrder",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "cost_center_id": { "type": "string" },
    "warehouse_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "contract_id": { "type": "string" },
    "opportunity_id": { "type": "string" },
    "service_order_number": { "type": "string" },
    "service_type": { "type": "string", "enum": ["laundry_piece", "laundry_weight", "hospital_pickup", "hospital_processing", "linen_delivery", "linen_collection", "corporate_cleaning", "inspection", "maintenance", "outsourcing", "other"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent", "critical"], "default": "normal" },
    "service_address_id": { "type": "string" },
    "scheduled_start_at": { "type": "string", "format": "date-time" },
    "scheduled_end_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "cancelled_at": { "type": "string", "format": "date-time" },
    "team_user_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "owner_user_id": { "type": "string" },
    "diagnosis": { "type": "string" },
    "execution_notes": { "type": "string" },
    "materials": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "default": [] },
    "checklist": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "default": [] },
    "document_asset_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "signature_asset_id": { "type": "string" },
    "customer_acceptance_status": { "type": "string", "enum": ["not_required", "pending", "accepted", "rejected"], "default": "not_required" },
    "customer_accepted_at": { "type": "string", "format": "date-time" },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "quality_notes": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "scheduled", "in_progress", "waiting_customer", "quality_review", "completed", "cancelled"], "default": "draft" },
    "cancellation_reason": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "created_by_user_id": { "type": "string" },
    "updated_by_user_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "business_party_id", "service_order_number", "service_type", "title", "status"]
}
