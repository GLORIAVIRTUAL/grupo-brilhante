{
  "name": "DomainEvent",
  "type": "object",
  "properties": {
    "event_key": { "type": "string" },
    "event_type": { "type": "string" },
    "aggregate_type": { "type": "string" },
    "aggregate_id": { "type": "string" },
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor_type": { "type": "string", "enum": ["user", "system", "provider", "migration"] },
    "actor_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "causation_id": { "type": "string" },
    "schema_version": { "type": "number", "default": 1 },
    "payload": { "type": "object", "additionalProperties": true },
    "payload_hash": { "type": "string" },
    "status": { "type": "string", "enum": ["recorded", "published", "failed"], "default": "recorded" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["event_key", "event_type", "aggregate_type", "aggregate_id", "legal_entity_id", "occurred_at", "actor_type", "schema_version", "payload_hash", "status"]
}
