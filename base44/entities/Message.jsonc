{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "channel": { "type": "string", "enum": ["WHATSAPP", "INSTAGRAM", "MESSENGER", "EMAIL", "SITE", "INTERNAL"] },
    "direction": {
      "type": "string",
      "enum": [
        "IN",
        "OUT"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "TEXT",
        "IMAGE",
        "AUDIO",
        "DOC",
        "INTERNAL_NOTE",
        "TEMPLATE",
        "SYSTEM"
      ]
    },
    "text": {
      "type": "string"
    },
    "media_file_id": {
      "type": "string"
    },
    "document_asset_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "message_template_id": { "type": "string" },
    "sender_type": { "type": "string", "enum": ["customer", "human", "ai", "system"], "default": "customer" },
    "sender_user_id": { "type": "string" },
    "internal_note": { "type": "boolean", "default": false },
    "delivery_status": { "type": "string", "enum": ["pending", "sent", "delivered", "read", "failed", "received"], "default": "pending" },
    "provider_message_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "sent_at": { "type": "string", "format": "date-time" },
    "raw_payload": {
      "type": "object"
    },
    "language_detected": {
      "type": "string"
    },
    "sent_by": {
      "type": "string",
      "description": "Nome de quem enviou a mensagem de sa\u00edda (atendente humano). Vazio = enviado pela Gl\u00f3ria (IA)."
    },
    "ai_pending": {
      "type": "boolean",
      "default": false,
      "description": "Marcado pelo webhook quando esta mensagem deve ser respondida pela IA. Dispara o gatilho autom\u00e1tico que chama a Gl\u00f3ria."
    },
    "ai_source": {
      "type": "string",
      "description": "Origem da conex\u00e3o para a IA responder pelo sender correto (ex: zapi_moinhos)."
    },
    "workflow_dispatch_token": {
      "type": "string",
      "description": "Token efêmero de uso único do workflow; removido após o despacho."
    },
    "ai_answered": {
      "type": "boolean",
      "default": false,
      "description": "Trava de idempot\u00eancia: marcado quando a IA j\u00e1 processou esta mensagem. Impede resposta duplicada."
    }
  },
  "required": [
    "conversation_id",
    "direction",
    "type"
  ]
}