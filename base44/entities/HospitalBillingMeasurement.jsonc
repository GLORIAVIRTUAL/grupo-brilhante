{
  "name": "HospitalBillingMeasurement",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "customer_unit_id": { "type": "string" },
    "business_contract_id": { "type": "string" },
    "measurement_number": { "type": "string" },
    "period_start": { "type": "string", "format": "date-time" },
    "period_end": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "calculated", "customer_review", "approved", "invoiced", "disputed", "cancelled"], "default": "draft" },
    "incoming_weight_kg": { "type": "number", "default": 0 },
    "billable_weight_kg": { "type": "number", "default": 0 },
    "clean_weight_kg": { "type": "number", "default": 0 },
    "piece_count": { "type": "number", "default": 0 },
    "loss_weight_kg": { "type": "number", "default": 0 },
    "loss_piece_count": { "type": "number", "default": 0 },
    "service_amount": { "type": "number", "default": 0 },
    "loss_charge_amount": { "type": "number", "default": 0 },
    "adjustment_amount": { "type": "number", "default": 0 },
    "total_amount": { "type": "number", "default": 0 },
    "calculation_snapshot": { "type": "object", "additionalProperties": true },
    "service_order_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "processing_lot_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "delivery_conference_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "accounts_receivable_id": { "type": "string" },
    "bank_charge_id": { "type": "string" },
    "fiscal_document_id": { "type": "string" },
    "approved_by_user_id": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "unit_id", "business_party_id", "business_contract_id", "measurement_number", "period_start", "period_end", "status", "idempotency_key"]
}
