{
  "name": "StaffNotification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "NEW_QUOTE",
        "COMPLAINT",
        "SLA_BREACH",
        "SYSTEM_ERROR",
        "NEW_IMAGES"
      ]
    },
    "target_team": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "ack_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "target_team"
  ]
}