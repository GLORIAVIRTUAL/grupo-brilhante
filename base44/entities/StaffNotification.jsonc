{
  "name": "StaffNotification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "NEW_QUOTE",
        "COMPLAINT",
        "SLA_BREACH",
        "SYSTEM_ERROR",
        "NEW_IMAGES",
        "EXECUTIVE_SUMMARY",
        "REPORT_READY",
        "APPROVAL_REQUIRED"
      ]
    },
    "target_team": {
      "type": "string"
    },
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "target_user_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "status": { "type": "string", "enum": ["pending", "sent", "acknowledged", "dismissed"], "default": "pending" },
    "payload": {
      "type": "object"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "ack_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "target_team"
  ]
}