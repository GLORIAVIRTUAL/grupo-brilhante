{
  "name": "HospitalDeliveryConference",
  "type": "object",
  "properties": {
    "legal_entity_id": { "type": "string" },
    "unit_id": { "type": "string" },
    "business_party_id": { "type": "string" },
    "customer_unit_id": { "type": "string" },
    "business_contract_id": { "type": "string" },
    "service_order_id": { "type": "string" },
    "hospital_processing_lot_id": { "type": "string" },
    "field_route_id": { "type": "string" },
    "conference_number": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "in_conference", "accepted", "accepted_with_divergence", "disputed", "cancelled"], "default": "pending" },
    "delivered_weight_kg": { "type": "number", "default": 0 },
    "accepted_weight_kg": { "type": "number", "default": 0 },
    "delivered_piece_count": { "type": "number", "default": 0 },
    "accepted_piece_count": { "type": "number", "default": 0 },
    "lost_piece_count": { "type": "number", "default": 0 },
    "damaged_piece_count": { "type": "number", "default": 0 },
    "divergence_reason": { "type": "string" },
    "delivered_at": { "type": "string", "format": "date-time" },
    "conferred_at": { "type": "string", "format": "date-time" },
    "driver_user_id": { "type": "string" },
    "conferred_by_name": { "type": "string" },
    "conferred_by_document_suffix": { "type": "string" },
    "signature_asset_id": { "type": "string" },
    "document_asset_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "idempotency_key": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["legal_entity_id", "unit_id", "business_party_id", "business_contract_id", "conference_number", "status", "idempotency_key"]
}
