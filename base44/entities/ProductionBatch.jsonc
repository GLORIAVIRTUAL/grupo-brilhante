{
  "name": "ProductionBatch",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "code": { "type": "string" },
    "stage": { "type": "string", "enum": ["washing", "drying", "dry_cleaning", "ironing", "finishing", "quality_control", "packaging"] },
    "status": { "type": "string", "enum": ["draft", "scheduled", "waiting_materials", "queued", "processing", "paused", "completed", "cancelled", "failed"], "default": "draft" },
    "machine_id": { "type": "string" },
    "machine_type": { "type": "string", "enum": ["wash", "dry", "iron", "dry_clean", "finishing", "quality", "packaging"] },
    "machine_capacity_kg_snapshot": { "type": "number" },
    "machine_capacity_items_snapshot": { "type": "number" },
    "location_id": { "type": "string" },
    "garment_item_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "order_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "service_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "piece_count": { "type": "number", "default": 0 },
    "total_weight_kg": { "type": "number", "default": 0 },
    "capacity_percent": { "type": "number", "default": 0 },
    "capacity_override": { "type": "boolean", "default": false },
    "capacity_override_reason": { "type": "string" },
    "recipe_id": { "type": "string" },
    "recipe_version_snapshot": { "type": "string" },
    "planned_consumption": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "default": [] },
    "actual_consumption": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "default": [] },
    "priority": { "type": "string", "enum": ["normal", "high", "urgent"], "default": "normal" },
    "operator_user_id": { "type": "string" },
    "operator_name": { "type": "string" },
    "scheduled_at": { "type": "string", "format": "date-time" },
    "queued_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "estimated_minutes": { "type": "number" },
    "actual_minutes": { "type": "number" },
    "paused_at": { "type": "string", "format": "date-time" },
    "total_pause_minutes": { "type": "number", "default": 0 },
    "pause_reason": { "type": "string" },
    "estimated_material_cost": { "type": "number", "default": 0 },
    "actual_material_cost": { "type": "number", "default": 0 },
    "estimated_labor_cost": { "type": "number", "default": 0 },
    "actual_labor_cost": { "type": "number", "default": 0 },
    "energy_cost": { "type": "number", "default": 0 },
    "water_cost": { "type": "number", "default": 0 },
    "other_cost": { "type": "number", "default": 0 },
    "total_actual_cost": { "type": "number", "default": 0 },
    "cost_variance": { "type": "number", "default": 0 },
    "completion_note": { "type": "string" },
    "cancellation_reason": { "type": "string" },
    "notes": { "type": "string" },
    "request_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["unit_id", "code", "stage", "status"]
}
